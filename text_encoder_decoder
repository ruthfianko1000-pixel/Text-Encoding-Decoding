def caesar_cipher(text, shift, mode):
    if mode == "decode":
        shift = -shift

    result = ""

    for char in text:
        if char.isupper():
            result += chr((ord(char) - 65 + shift) % 26 + 65)
        elif char.islower():
            result += chr((ord(char) - 97 + shift) % 26 + 97)
        else:
            result += char

    return result


def main():
    print("===== TEXT ENCODER AND DECODER =====")
    print("1. Encode Text")
    print("2. Decode Text")
    print("3. Exit")

    while True:
        choice = input("\nEnter your choice: ")

        if choice == "3":
            print("Thank you for using the program!")
            break

        elif choice in ["1", "2"]:
            message = input("Enter your text: ")

            try:
                shift = int(input("Enter shift number: "))

                if choice == "1":
                    result = caesar_cipher(message, shift, "encode")
                    print("Encoded Text:", result)
                else:
                    result = caesar_cipher(message, shift, "decode")
                    print("Decoded Text:", result)

            except ValueError:
                print("Please enter a valid number.")

        else:
            print("Invalid choice. Select 1, 2 or 3.")


if _name_ == "_main_":
    main()
